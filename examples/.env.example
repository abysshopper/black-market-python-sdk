# Copy to .env in your working directory. Existing environment values win.
# Running a launch_*.py example deliberately spends funds and publishes via the API.
PRIVATE_KEY=
LAUNCH_API_URL=
# Optional: defaults to the SDK official chain4663 mainnet RPC.
RPC_URL=
# Optional: separate exclusively owned loopback Anvil for canonical SDK simulation.
# Otherwise the SDK uses the execution RPC's native simulation backend.
SIMULATION_RPC_URL=
# Optional ERC404 NFT base URI that you host; empty means no hosted NFT metadata.
NFT_BASE_URI=
# EXAMPLE ceilings, NOT verified provider/account limits; actual block limit applies.
# LAUNCH_CHAIN_GAS_CAP=16000000
# LAUNCH_RPC_GAS_CAP=16000000
# LAUNCH_ACCOUNT_GAS_CAP=16000000
# LAUNCH_CALLDATA_CAP=131072
