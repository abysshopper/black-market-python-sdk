# Copy with: cp -n examples/.env.example .env; chmod 600 .env
# Existing process environment values override .env.
# python examples/launch_erc20_abyss.py plans without signing, uploading, or publishing.
# --broadcast spends funds and publishes a FRESH plan, without a confirmation prompt.
# After partial execution, --resume <original-run-dir> continues that same launch.
# Planning and execution both derive the creator from exactly one key source below.
PRIVATE_KEY=
# Alternative to PRIVATE_KEY (configure exactly one): owner-only local V3 JSON keystore.
# EXAMPLE_KEYSTORE_PATH=
# Empty password is supported; never commit passwords or decrypted keys.
# EXAMPLE_KEYSTORE_PASSWORD=
# Public mainnet Abyss API; set another origin only for your own deployment.
LAUNCH_API_URL=https://api.abyss.trading
# Optional: defaults to the SDK official chain4663 mainnet RPC.
RPC_URL=
# Optional separate Abyss Kyber API; defaults to LAUNCH_API_URL.
# EXAMPLE_KYBER_API_URL=
# Native ETH input per ordered buy; keep additional ETH for gas.
# WETH uses NativeWrap (ETH wrapping). Other quotes, such as USDG, use Kyber SWAP.
# Defaults to 0.00001 ETH per buy. Custom SDK plans can also use direct ERC20 funding.
# EXAMPLE_BUY_AMOUNT_WEI=10000000000000
# Optional exact positive USD valuation target.
# EXAMPLE_TARGET_MARKET_CAP_USD=5000
# Optional case identity overrides; unset preserves each case's defaults.
# EXAMPLE_TOKEN_NAME=
# EXAMPLE_TOKEN_SYMBOL=
# EXAMPLE_TOKEN_DESCRIPTION=
# Optional PNG/JPEG/WebP image (maximum 5 MiB); dry-run saves the descriptor without uploading.
# --broadcast signs/uploads/verifies it; unset keeps metadata-only staging.
# EXAMPLE_IMAGE_PATH=
# Native Nitro simulation runs read-only on RPC_URL; generic Anvil cannot prove chain4663 metering.
# Optional ERC404 NFT base URI that you host; empty means no hosted NFT metadata.
NFT_BASE_URI=
# Optional positive integer tightening policy. No invented gas/calldata caps by default.
# Native protocol reads and complete exact-envelope replay remain mandatory.
# LAUNCH_CHAIN_GAS_CAP=
# LAUNCH_RPC_GAS_CAP=
# LAUNCH_ACCOUNT_GAS_CAP=
# LAUNCH_CALLDATA_CAP=
